#!/usr/bin/env bash
#
# Verify command for `land` (see .claude/land.conf): build everything, then run the macOS-slice tests.
# Prints only the `verify:` protocol; full tool output goes to $LAND_ARTIFACT_DIR.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2
cat >/dev/null # changed paths on stdin; every phase always runs

artifacts="${LAND_ARTIFACT_DIR:-$(mktemp -d)}"
mkdir -p "$artifacts"
failed=0

# The build tool colours its output even when piped.
# shellcheck disable=SC2329
plain() { sed $'s/\x1b\\[[0-9;]*m//g' "$1"; }

# Compiler errors as `File.swift: message` so line numbers never make two trees differ.
# shellcheck disable=SC2329 # called by name from run_phase
compile_failures() {
    plain "$1" | sed -nE 's|^.*/([^/:]+):[0-9]+:[0-9]+: error: (.*)$|\1: \2|p' | sort -u
}

# XCTest `-[Module.Class testName]` becomes `Module.Class/testName`; swift-testing reports the display name.
# shellcheck disable=SC2329
test_failures() {
    {
        plain "$1" | sed -nE "s|^Test Case '-\[([^ ]+) ([^]]+)\]' failed.*|\1/\2|p"
        plain "$1" | sed -nE 's|^.*✘ Test (.+) failed after .*|\1|p'
    } | sort -u
}

run_phase() {
    local phase="$1" extractor="$2"
    shift 2
    local log="$artifacts/$phase.log"
    echo "verify: == $phase"
    if "$@" >"$log" 2>&1; then
        return
    fi
    failed=1
    local failures
    failures="$("$extractor" "$log")"
    if [[ -n "$failures" ]]; then
        while IFS= read -r line; do echo "verify: !! $line"; done <<<"$failures"
    fi
    echo "verify: -- $phase failed: see $log"
    tail -n 15 "$log" | sed 's/^/  | /' >&2
}

run_phase build compile_failures swift build --build-tests
run_phase test test_failures swift test --skip-build

echo "verify: == end"
exit "$failed"
